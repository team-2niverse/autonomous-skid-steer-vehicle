static struct udp_pcb *g_multicast_pcb;
void multicast_recv_callback(void *arg, struct udp_pcb *pcb, struct pbuf *p,
                             const ip_addr_t *addr, u16_t port);
err_t multicast_udp_bind_and_listen(void)
{
    err_t err;

    // 1. 새로운 UDP PCB 생성
    g_multicast_pcb = udp_new();

    if (g_multicast_pcb == NULL)
    {
        my_printf("Error: Could not create UDP PCB.\n");
        return ERR_MEM; // 메모리 할당 실패
    }

    // 2. PCB를 특정 포트에 바인딩 (IP_ADDR_ANY 사용)
    // IP_ADDR_ANY는 모든 로컬 인터페이스에서 패킷을 받겠다는 의미입니다.
    err = udp_bind(g_multicast_pcb, IP_ADDR_ANY, 30490);

    if (err != ERR_OK)
    {
        my_printf("Error: Could not bind UDP PCB to port %d. Error code: %d\n", 30490, err);
        udp_remove(g_multicast_pcb);
        return err;
    }

    // 3. 수신 콜백 함수 등록
    // 이 포트로 UDP 패킷이 들어오면 multicast_recv_callback 함수가 호출됩니다.
    udp_recv(g_multicast_pcb, multicast_recv_callback, NULL);

    my_printf("UDP Multicast Listener started on port %d.\n", 30490);
    return ERR_OK;
}
void multicast_recv_callback(void *arg, struct udp_pcb *pcb, struct pbuf *p,
                             const ip_addr_t *addr, u16_t port)
{
    // 패킷(p)이 NULL이 아닌지 확인 (lwIP 규약)
    if (p != NULL)
    {
        // 1. 수신된 데이터 처리
        my_printf("Received %d bytes from IP %s, Port %d\n",
                  p->tot_len, ipaddr_ntoa(addr), port);

        // pbuf에서 실제 데이터에 접근하는 방법
        // (p->payload는 첫 번째 버퍼의 시작점, p->len은 첫 번째 버퍼의 길이)
        // char *data = (char *)p->payload;

        // 2. 데이터 처리 완료 후 패킷 버퍼 해제
        // 패킷을 처리한 후에는 반드시 pbuf_free()를 호출해야 메모리 누수를 방지할 수 있습니다.
        pbuf_free(p);
    }
}

