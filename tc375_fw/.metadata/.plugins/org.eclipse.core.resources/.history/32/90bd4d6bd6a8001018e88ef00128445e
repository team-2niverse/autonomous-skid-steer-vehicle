/* This interrupt is raised by the GPT12 T5 timer every 1ms */
IFX_INTERRUPT(SomeIp_Gpt2_T5_Isr_Handler, 0, ISR_PRIORITY_GPT2T5_TIMER);
void SomeIp_Gpt2_T5_Isr_Handler(void)
{
    static volatile uint32 counter = 0;
    counter++;

    if (counter == 100)
    {
        counter = 0;
        g_100ms_event_flag = TRUE;
    }
}

void SomeIp_Init_100ms_Interrupt(void)
{
    /* Start the GPT12 timer (T5) for the 100ms event tick (based on 1ms hardware tick) */
    Gpt12_Run_Gpt2_T5();
}


